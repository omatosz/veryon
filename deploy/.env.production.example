# Copie para deploy/.env e preencha. Este arquivo nunca é commitado (deploy/.env está
# no .gitignore, na mesma regra do .env da raiz).

# --- PostgreSQL / TimescaleDB ---
# Sem porta publicada neste compose: só quem está na rede interna do projeto fala com o
# banco. Troque a senha, nunca use "changeme" fora do laboratório.
POSTGRES_USER=socadmin
POSTGRES_PASSWORD=
POSTGRES_DB=socsiem

# --- Onde este Veryon fica exposto ---
# O IP ou domínio da VPS. Sem TLS neste pacote (ver README.md), então é http:// mesmo.
# BACKEND_PORT e WEB_PORT são as portas do host; troque só se 8000 ou 80 já estiverem
# ocupadas na VPS.
BACKEND_PORT=8000
WEB_PORT=80

# Endereço público da API, gravado dentro do JavaScript do painel no momento do build.
# Trocar depois exige reconstruir a imagem "web" (ver README.md).
VITE_API_URL=http://SEU_DOMINIO_OU_IP:8000

# Origem de onde o painel é servido, autorizada a chamar a API. Sem isso aqui igual ao
# endereço real do painel, o navegador bloqueia toda resposta da API com erro de CORS.
CORS_ORIGINS=http://SEU_DOMINIO_OU_IP

# Fica falso aqui de propósito. Este pacote é para infraestrutura de cliente real, que
# não tem honeypot nem alvo vulnerável, então a rota de demonstração nem faria sentido.
DEMO_MODE_ENABLED=false

# --- Autenticação ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ADMIN_USERNAME=admin
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=

# --- Threat Intel ---
# Contas gratuitas em abuseipdb.com, virustotal.com e otx.alienvault.com. Vazio
# desliga só aquela fonte, não trava o resto.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# --- Análise de API ---
# Chave que um gateway externo usa para mandar log de acesso pro POST
# /ingest/api-logs, no cabeçalho X-Veryon-Key. Vazio desliga o endpoint.
# Gere com: python -c "import secrets; print(secrets.token_hex(20))"
INGEST_API_KEY=

# --- Varredura de vulnerabilidade ---
# Sem valor, o scanner varre só os próprios serviços internos (não acha nada de
# cliente, só prova que está funcionando). Aponte para os hosts e URLs reais deste
# cliente, separados por vírgula, no mesmo formato do compose de desenvolvimento:
# host:porta para nmap, alvo@http://host:porta para nuclei.
SCANNER_NMAP_TARGETS=
SCANNER_NUCLEI_TARGETS=

# --- Notificações ---
NOTIFICATIONS_ENABLED=false
NOTIFICATION_MIN_LEVEL=high
NOTIFICATION_GROUP_MINUTES=10
NOTIFICATION_MAX_PER_HOUR=20
NOTIFICATION_POLL_SECONDS=15
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_TIMEOUT_SECONDS=10

# SMTP, usado pelos canais tipo 'email'. Gmail e Office365 exigem senha de aplicativo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Retenção e compressão no Timescale ---
# Mesmos campos do .env de desenvolvimento. 0 desliga aquela política.
RETENTION_ENABLED=true
RAW_EVENTS_COMPRESS_AFTER_DAYS=7
RAW_EVENTS_DROP_AFTER_DAYS=90
ALERTS_COMPRESS_AFTER_DAYS=30
ALERTS_DROP_AFTER_DAYS=0
API_REQUESTS_COMPRESS_AFTER_DAYS=2
API_REQUESTS_DROP_AFTER_DAYS=7
