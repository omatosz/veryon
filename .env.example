# PostgreSQL / TimescaleDB
POSTGRES_USER=socadmin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=socsiem
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000

# API auth (Fase 6). Gere um secret próprio, ex: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Threat Intel (Fase 5). Crie contas gratuitas e cole suas chaves aqui
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# Análise de API
# Chave que o gateway de um cliente usa pra mandar log de acesso pro endpoint
# POST /ingest/api-logs, no cabecalho X-Veryon-Key. Deixar vazio desliga a
# ingestão: sem chave, o endpoint recusa tudo em vez de aceitar de qualquer um.
# Gere a sua com: python -c "import secrets; print(secrets.token_hex(20))"
INGEST_API_KEY=

# Notificações
# Liga o notificador. Desligado, o laco nem sobe. Ao ligar, ele comeca a
# valer do alerta mais recente pra frente: alerta antigo não vira e-mail.
NOTIFICATIONS_ENABLED=false
# Severidade minima global. Cada canal ainda pode exigir mais que isso.
# Valores: informational, low, medium, high, critical
NOTIFICATION_MIN_LEVEL=high
# Janela de agrupamento, em minutos. Dentro dela, o mesmo par regra+IP não
# gera mensagem nova; o alerta repetido vira contador na que ja saiu.
NOTIFICATION_GROUP_MINUTES=10
# Teto de mensagens por canal por hora. Ao bater, a mensagem espera em vez
# de ser descartada.
NOTIFICATION_MAX_PER_HOUR=20
NOTIFICATION_POLL_SECONDS=15
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_TIMEOUT_SECONDS=10

# SMTP, usado pelos canais de tipo 'email'.
# So o servidor e a credencial ficam aqui; o destinatário fica no cadastro do
# canal, na tabela notification_channels.
# Gmail e Office365 exigem senha de aplicativo, não a senha da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Vazio usa o SMTP_USER como remetente.
SMTP_FROM=
# STARTTLS na 587 e o caso comum. Para TLS implicito na 465, use
# SMTP_SSL=true e SMTP_STARTTLS=false.
SMTP_STARTTLS=true
SMTP_SSL=false

# Retenção e compressão no Timescale
# Sem isto o banco cresce para sempre e um dia o disco enche. Os prazos abaixo
# são lidos a cada boot do backend e aplicados no banco, então trocar um número
# aqui e reiniciar o backend basta. Não precisa de migration nem de psql.
# Em qualquer campo, 0 desliga aquela política.
#
# "comprimir" não apaga nada: o dado continua consultavel, so passa a ocupar
# muito menos. Medido neste projeto, com dados reais: 20 vezes menos.
# "apagar" apaga mesmo, e não volta.
#
# Desligado, nada e comprimido nem apagado, e o backend remove as políticas
# que encontrar no banco.
RETENTION_ENABLED=true

# Evento cru do honeypot e dos coletores.
RAW_EVENTS_COMPRESS_AFTER_DAYS=7
RAW_EVENTS_DROP_AFTER_DAYS=90

# Alerta. Padrão e nunca apagar (0), porque alerta e a memória do produto.
# Comprimido ele ocupa pouco, então guardar sai barato.
ALERTS_COMPRESS_AFTER_DAYS=30
ALERTS_DROP_AFTER_DAYS=0

# Tráfego de API, o maior volume do sistema. Dois dias antes de comprimir, e
# não um, porque o analisador calcula a linha de base olhando 24h para tras.
API_REQUESTS_COMPRESS_AFTER_DAYS=2
API_REQUESTS_DROP_AFTER_DAYS=7
